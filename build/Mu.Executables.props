<Project>
  <PropertyGroup>
    <_MuifyAssemblyName Condition="'$(AssemblyName)' != ''">$(AssemblyName)</_MuifyAssemblyName>
    <_MuifyAssemblyName Condition="'$(_MuifyAssemblyName)' == ''">$(MSBuildProjectName)</_MuifyAssemblyName>
    <_MuifyRootNamespace Condition="'$(RootNamespace)' != ''">$(RootNamespace)</_MuifyRootNamespace>
    <_MuifyRootNamespace Condition="'$(_MuifyRootNamespace)' == ''">$(MSBuildProjectName.Replace(' ', '_'))</_MuifyRootNamespace>
    <_MuifyIsHost>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_MuifyAssemblyName)', '^.+\.Host$'))</_MuifyIsHost>
    <_MuifyIsHost Condition="'$(_MuifyIsHost)' != 'True'">$([System.Text.RegularExpressions.Regex]::IsMatch('$(_MuifyRootNamespace)', '^.+\.Host$'))</_MuifyIsHost>
    <OutputType Condition="'$(OutputType)' == '' AND '$(IsTestProject)' != 'true' AND '$(IsRoslynProject)' != 'true' AND '$(_MuifyIsHost)' == 'True' AND !$([System.String]::Copy('$(_MuifyAssemblyName)').EndsWith('.Tests')) AND !$([System.String]::Copy('$(_MuifyAssemblyName)').EndsWith('.Analyzers')) AND !$([System.String]::Copy('$(_MuifyAssemblyName)').EndsWith('.Generators'))">Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>
</Project>