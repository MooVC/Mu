<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" PrivateAssets="all" ExcludeAssets="analyzers;build;buildTransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" PrivateAssets="all" />
    <PackageReference Include="MooVC" PrivateAssets="all" ExcludeAssets="analyzers;build;buildTransitive">
      <IncludeAssets>runtime; compile; native; contentfiles</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MooVC.Modelling" PrivateAssets="all" ExcludeAssets="analyzers;build;buildTransitive">
      <IncludeAssets>runtime; compile; native; contentfiles</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MooVC.Syntax" PrivateAssets="all" ExcludeAssets="analyzers;build;buildTransitive">
      <IncludeAssets>runtime; compile; native; contentfiles</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MooVC.Syntax.CSharp" PrivateAssets="all" ExcludeAssets="analyzers;build;buildTransitive">
      <IncludeAssets>runtime; compile; native; contentfiles</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Mu.Modelling">
      <HintPath>..\Mu.Modelling\bin\$(Configuration)\netstandard2.0\Mu.Modelling.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Mu.Modelling.Testing">
      <HintPath>..\Mu.Modelling.Testing\bin\$(Configuration)\netstandard2.0\Mu.Modelling.Testing.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>